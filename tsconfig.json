{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-review/types/**/*.ts",
    ".next-asia-phase-a/types/**/*.ts",
    "tmp/tools/north-america-preview/.next/types/**/*.ts",
    "tmp/tools/north-america-build/.next/types/**/*.ts",
    "tmp/tools/oceania-a-preview/.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "documentation/world-explorer/review/**/shared-loading-baseline/**"
  ]
}

# Copy to .env.local for development; never commit real keys.
# In Vercel, set these in the intended Production and Preview environments.
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional public alias; next.config.js also accepts SUPABASE_ANON_KEY.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never put the service-role key in any NEXT_PUBLIC_ variable.

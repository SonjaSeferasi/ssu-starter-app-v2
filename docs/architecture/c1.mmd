---
config:
  theme: base
  themeVariables:
    fontFamily: Arial
    fontSize: 36px
    lineColor: '#395664'
    edgeLabelBackground: '#ffffff'
    primaryTextColor: '#163743'
---
%% C1 - Context Diagram | SocialU
%% Authors: left blank for the team to assign.
%% Scope: planned semester architecture, one launch university.
%% External names must remain Supabase and Resend in C2 and C3.
%% Student is the only top-level user class in the approved URD.
%% Email traces: SRS-101.2, SRS-102.2, SRS-103.7, SRS-104.2,
%% SRS-105.16, SRS-106.6. Resend is a proposed delivery integration.
%% Resend delivers messages; SocialU owns code validity and verification rules.
%% Account-provider/schema mapping remains an implementation design decision.
%% Wordle and automatic background removal are conditional, not required services.
%% Relationship arrows show uses/dependencies; responses are implicit.
%% Student is rendered using C4's Person element rather than a rectangular flowchart node.
%% The slide PNG/SVG is manually arranged from the same four entities and four
%% relationships; Mermaid may arrange the same model differently.
C4Context
    Person(Student, "Student", "Student at the launch university.")
    System(SocialU, "SocialU", "University community platform.<br/>Feeds, profiles and friendships.<br/>Messages and campus events.<br/>Games, avatars and virtual dorms.<br/>Shared streaks and points.")
    System_Ext(Supabase, "Supabase", "Managed account services;<br/>stores records and photographs.")
    System_Ext(Resend, "Resend", "Delivers verification,<br/>password-reset and security emails.")

    Rel(Student, SocialU, "Uses SocialU")
    Rel(SocialU, Supabase, "Authenticates; stores content")
    Rel(SocialU, Resend, "Requests account emails")
    Rel(Resend, Student, "Delivers account emails")

    UpdateElementStyle(Student, $bgColor="#173f52", $fontColor="#ffffff", $borderColor="#173f52")
    UpdateElementStyle(SocialU, $bgColor="#e3f0e8", $fontColor="#163743", $borderColor="#31735b")
    UpdateElementStyle(Supabase, $bgColor="#f0f3f5", $fontColor="#163743", $borderColor="#6e7f89")
    UpdateElementStyle(Resend, $bgColor="#f0f3f5", $fontColor="#163743", $borderColor="#6e7f89")
    UpdateRelStyle(Student, SocialU, $lineColor="#395664", $textColor="#163743")
    UpdateRelStyle(SocialU, Supabase, $lineColor="#395664", $textColor="#163743")
    UpdateRelStyle(SocialU, Resend, $lineColor="#395664", $textColor="#163743")
    UpdateRelStyle(Resend, Student, $lineColor="#395664", $textColor="#163743")

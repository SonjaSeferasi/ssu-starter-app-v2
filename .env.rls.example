# Copy manually to .env.rls.local (ignored by Git). Never use production keys.
# Use Node 22+ and a disposable Supabase instance containing the real app schema.
RLS_TEST_SUPABASE_URL=https://YOUR_DISPOSABLE_PROJECT_REF.supabase.co
RLS_TEST_PROJECT_REF=YOUR_DISPOSABLE_PROJECT_REF
RLS_TEST_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Used ONLY by fixture administration/verification, never by attacker clients.
RLS_TEST_SERVICE_ROLE_KEY=YOUR_DISPOSABLE_PROJECT_SECRET_OR_SERVICE_ROLE_KEY
# Set these only after YOU have confirmed the project and notified teammates.
RLS_TEST_CONFIRM_DISPOSABLE=no
RLS_TEST_TEAM_NOTIFIED=no
